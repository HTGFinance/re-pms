# Company name shown in the app, receipts and Excel files (white-label for a future sale)
BRAND_NAME=Hamdan Properties
BRAND_SHORT=Hamdan Properties
BRAND_TAGLINE=Property Management System

# Copy to .env and change every value marked CHANGE.
# --- Database (PostgreSQL 14+) ---
DB_HOST=db
DB_PORT=5432
DB_USER=repms
DB_PASSWORD=CHANGE-strong-db-password
DB_NAME=repms
DB_SSL=false
# --- API ---
PORT=4000
JWT_SECRET=CHANGE-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://pms.example.om
COOKIE_SECURE=true
# Municipality lease registration fee on annual rent (confirm current rate)
MUNICIPALITY_FEE_RATE=0.03
# --- First admin login (used once by the seed step) ---
ADMIN_EMAIL=admin@example.om
ADMIN_PASSWORD=CHANGE-first-admin-password

# --- Tenant app ---
# Bank account shown to tenants for rent transfers
RENT_BANK_NAME=Bank Muscat
RENT_ACCOUNT_NAME=CHANGE-company-name
RENT_ACCOUNT_NO=CHANGE
RENT_IBAN=CHANGE
# Complaints left unanswered by the tenant after completion are closed automatically after this many days
COMPLAINT_AUTO_CLOSE_DAYS=7
# Uploaded photos and receipts (mounted as a Docker volume)
UPLOAD_DIR=/data/uploads
# Maintenance costs above this amount (OMR) need approval by a property manager or finance
MAINTENANCE_APPROVAL_LIMIT=200
