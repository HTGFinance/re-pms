# Copy to .env and change every value marked CHANGE.
# --- Database (PostgreSQL 14+) ---
DB_HOST=db
DB_PORT=5432
DB_USER=repms
DB_PASSWORD=CHANGE-strong-db-password
DB_NAME=repms
DB_SSL=false
# --- API ---
PORT=4000
JWT_SECRET=CHANGE-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://pms.example.om
COOKIE_SECURE=true
# Municipality lease registration fee on annual rent (confirm current rate)
MUNICIPALITY_FEE_RATE=0.03
# --- First admin login (used once by the seed step) ---
ADMIN_EMAIL=admin@example.om
ADMIN_PASSWORD=CHANGE-first-admin-password
